#include <stdio.h> 

int main(void){ // pascal

    int row;
    scanf("%d", &row);

    // a_i = a_i-1 * (n - i + 1) / i;
    for(int i = 0; i < row; i++){ // n
        int head = 1;
        for(int j = 0; j <= i; j++){ // i    
            printf("%d ", head);
            head = head * (i - j) / (j + 1);
        }

        printf("\n");
    }

    return 0;
}
