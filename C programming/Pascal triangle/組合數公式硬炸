#include <stdio.h>

void pas(int n){

    for(int i = 0; i <= n; i++){
        // c(n, i)
        long long num = 1, den = 1;
        // 分子 num
        for(int j = n; j > (n - i); j--){
            num = num * j;
        }
        // 分母 den
        for(int k = 1; k <= i; k++){
            den = den * k;
        }

        printf("%lld ", num / den);
    }

}

int main(void){

    int n;
    scanf("%d", &n);

    for(int i = 0; i < n; i++){
        pas(i);
        printf("\n");
    }
    
    return 0;
}
